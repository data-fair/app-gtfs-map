{
  "name": "@data-fair/app-gtfs-map",
  "version": "1.0.4",
  "description": "A map application for data-fair: GTFS network with real-time vehicles",
  "type": "module",
  "author": "data-fair",
  "license": "MIT",
  "scripts": {
    "dev": "df-dev-env && dotenv -- zellij --layout .zellij.kdl",
    "dev-server": "df-dev-server",
    "dev-app": "vite",
    "build": "npm run prepareBuild && PUBLIC_URL=https://cdn.jsdelivr.net/npm/@data-fair/app-gtfs-map@${npm_package_version}/dist vite build",
    "build-preview": "npm run prepareBuild && vite build",
    "build-types": "df-build-types src/config",
    "prepareBuild": "npm run build-types",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare": "husky || true",
    "type-check": "vue-tsc --noEmit",
    "test": "df-dev-env && dotenv -- playwright test --max-failures=1",
    "test-unit": "playwright test --project unit",
    "test-e2e": "df-dev-env && dotenv -- playwright test --project e2e",
    "replay-gif": "playwright test --config scripts/replay.config.ts",
    "quality": "npm run lint && npm run build-types && npm run type-check && npm run build && npm test && npm audit --omit=dev --audit-level=critical",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "/dist",
    "package.json",
    "README.md"
  ],
  "dependencies": {
    "@data-fair/lib-utils": "^1.13.1",
    "@data-fair/lib-vue": "^1.30.1",
    "@data-fair/lib-vuetify": "^2.4.3",
    "@mdi/js": "^7.4.47",
    "@vueuse/core": "^14.2.1",
    "dayjs": "^1.11.20",
    "gtfs-realtime-bindings": "^2.2.0",
    "maplibre-gl": "^6.9.0",
    "ofetch": "^1.5.1",
    "vue": "^3.5.33",
    "vue-i18n": "^11.4.10",
    "vuetify": "^4.2.0"
  },
  "peerDependencies": {
    "@data-fair/lib-utils": "^1.13.1",
    "@data-fair/lib-vue": "^1.30.1",
    "@data-fair/lib-vuetify": "^2.4.3",
    "@vueuse/core": ">=10",
    "dayjs": "1",
    "ofetch": "1",
    "vue": "3",
    "vue-i18n": "10 || 11",
    "vuetify": "4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@data-fair/dev-server": "^2.6.2",
    "@data-fair/lib-types-builder": "^1.14.3",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "eslint-plugin-vuetify": "^2.7.2",
    "husky": "^9.1.7",
    "neostandard": "^0.13.0",
    "sass-embedded": "^1.104.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.2.7"
  }
}
