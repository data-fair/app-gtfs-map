{
  "type": "object",
  "required": ["datasets"],
  "layout": "tabs",
  "allOf": [
    {
      "title": "Source de données",
      "properties": {
        "datasets": {
          "type": "array",
          "minItems": 1,
          "items": [
            {
              "title": "Jeu de données GTFS",
              "description": "Le jeu de métadonnées produit par le traitement GTFS (sans données). Seuls ces jeux sont proposés ; les jeux liés « tracés », « arrêts » et « horaires » sont détectés automatiquement et ajoutés à la configuration.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "href": { "type": "string" },
                "title": { "type": "string" },
                "id": { "type": "string" },
                "schema": { "type": "array" },
                "relatedDatasets": { "type": "array" }
              },
              "layout": {
                "getItems": {
                  "url": "api/v1/datasets?type=metaOnly&q={q}&select=id,title,schema,relatedDatasets&${context.datasetFilter}&size=50",
                  "itemKey": "data[\"href\"]",
                  "itemTitle": "data[\"title\"]",
                  "itemsResults": "data.results.filter(d => (d.relatedDatasets ?? []).length >= 3)"
                }
              }
            }
          ]
        }
      }
    },
    {
      "title": "Temps réel",
      "properties": {
        "realtime": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Afficher les véhicules en temps réel",
              "description": "Les positions proviennent du flux GTFS-RT déclaré comme pièce jointe distante du jeu de métadonnées.",
              "default": true
            },
            "refreshInterval": {
              "type": "number",
              "title": "Intervalle de rafraîchissement (en secondes)",
              "default": 15,
              "minimum": 5,
              "maximum": 120,
              "layout": {
                "if": "rootData.realtime && rootData.realtime.enabled"
              }
            },
            "url": {
              "type": "string",
              "title": "URL du flux GTFS-RT",
              "description": "Pré-renseignée automatiquement à partir de la pièce jointe GTFS-RT du jeu de données sélectionné ; à modifier seulement pour forcer un autre flux.",
              "layout": {
                "if": "rootData.realtime && rootData.realtime.enabled"
              }
            }
          }
        }
      }
    },
    {
      "title": "Affichage",
      "properties": {
        "map": {
          "type": "object",
          "properties": {
            "style": {
              "type": "string",
              "title": "Fond de carte",
              "default": "klokantech-basic",
              "oneOf": [
                { "const": "klokantech-basic", "title": "Klokantech Basic" },
                { "const": "minimal", "title": "Minimal" },
                { "const": "void", "title": "Vide" },
                { "const": "admindiv", "title": "Divisions administratives" },
                { "const": "dark-matter", "title": "Dark Matter" },
                { "const": "fiord-color", "title": "Fiord Color" },
                { "const": "osm-bright", "title": "OSM Bright" },
                { "const": "positron", "title": "Positron" },
                { "const": "osm-liberty", "title": "OSM Liberty" },
                { "const": "cassini", "title": "Cassini" },
                { "const": "cadastre", "title": "Cadastre" },
                { "const": "satellite", "title": "Vue satellite" },
                { "const": "plan-ign-standard", "title": "Plan IGN" }
              ]
            },
            "lineWidth": {
              "type": "integer",
              "default": 4,
              "minimum": 1,
              "maximum": 15,
              "layout": {
                "comp": "slider",
                "step": 1,
                "label": "",
                "slots": { "before": "Épaisseur des tracés" },
                "props": { "showTicks": "always", "thumbLabel": true }
              }
            },
            "stopRadius": {
              "type": "integer",
              "default": 5,
              "minimum": 2,
              "maximum": 12,
              "layout": {
                "comp": "slider",
                "step": 1,
                "label": "",
                "slots": { "before": "Taille des arrêts" },
                "props": { "showTicks": "always", "thumbLabel": true }
              }
            },
            "vehicleSize": {
              "type": "integer",
              "default": 8,
              "minimum": 4,
              "maximum": 16,
              "layout": {
                "comp": "slider",
                "step": 1,
                "label": "",
                "slots": { "before": "Taille des véhicules" },
                "props": { "showTicks": "always", "thumbLabel": true }
              }
            },
            "fallbackColor": {
              "type": "string",
              "title": "Couleur de repli",
              "description": "Utilisée pour les lignes et véhicules sans couleur GTFS (route_color).",
              "default": "#1976D2",
              "layout": "color-picker"
            }
          }
        }
      }
    }
  ]
}
